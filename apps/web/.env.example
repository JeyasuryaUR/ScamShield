# Copy to .env.local. Local values come from `npx supabase status` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
# Server only. Used solely by /api/pay/respond to record the demo customer's answer.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>

# The FastAPI scorer (services/scorer)
SCORER_URL=http://127.0.0.1:8000
SCORER_API_KEY=

# Optional: friendlier EN/TA customer warnings. Without it, built-in templates are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
