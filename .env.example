# Repo-root .env for the scorer and the Python tools (publish.py, create_user.py, replayer).
# The web app has its own: apps/web/.env.example

# Supabase (local values from `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>

# Scorer
SCORER_URL=http://127.0.0.1:8000
# Optional. If set, callers must send it as the X-API-Key header.
SCORER_API_KEY=
# What the scorer writes to Supabase: all | flagged | off
SINK_MODE=all
# Seed the /pay demo customer's payment history at startup
DEMO_SEED=1
